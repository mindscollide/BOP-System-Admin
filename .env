# ========= Base URLs =========
REACT_APP_API_BASE_URL=https://boptrade.tresmark.com

# ========= API Ports / Paths =========
REACT_APP_AUTH_PORT=:5021/ERM_Auth
REACT_APP_SYSTEM_ADMIN_PORT=:5029/SystemAdmin
REACT_APP_SECURITY_ADMIN_PORT=:5027/SecurityAdmin
REACT_APP_DOWNLOAD_REPORT_PORT=:5026/ExcelReport
REACT_APP_SETTINGS_PORT=:5028/Setting
REACT_APP_UPLOAD_RATE_PORT=:5030/UploadRate
REACT_APP_WATCHLIST_PORT=:5031/WatchList
REACT_APP_BLOTTER_PORT=:5022/Blotter
REACT_APP_BOP_KEY=TRADEANDTREASURYAuth

# ========= MQTT Config =========
REACT_APP_MQTT_PORT=8883
REACT_APP_MQTT_HOST=boptrade.tresmark.com
REACT_APP_MQTT_USERNAME=user1
REACT_APP_MQTT_PASSWORD=password1


